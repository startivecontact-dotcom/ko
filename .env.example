# ─── KAO Society — Environment Variables Example ─────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Connection string used by Prisma at runtime (pooled via PgBouncer).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection string used by Prisma migrations (no pooler).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Public URL of your application (no trailing slash).
NEXTAUTH_URL="http://localhost:3000"

# Strong random secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-very-long-random-secret-here"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Supabase (optional — for file uploads / realtime) ───────────────────────
# Found in your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Email / SMTP (optional — for transactional emails via Nodemailer) ────────
# Example using Gmail SMTP with an App Password:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="KAO Society <noreply@kaosociety.fr>"

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL exposed to client-side code.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="KAO Society"

# Default timezone for event dates.
NEXT_PUBLIC_TIMEZONE="Europe/Paris"
